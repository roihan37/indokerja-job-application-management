DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indokerja?schema=public
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Required only when seeding. Choose a demo-only password (12+ characters).
DEMO_PASSWORD=replace-with-a-demo-only-password

# Tests only: use a separate database ending in _test, never the application DB.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indokerja_test?schema=public

# Resume storage only: create a PRIVATE bucket in Supabase before enabling uploads.
# Never expose this secret through VITE_ variables.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=replace-with-your-server-only-secret
SUPABASE_STORAGE_BUCKET=candidate-resumes
